{
  "name": "@ovs/web",
  "engines": {
    "node": "24.19.x"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "format": "bash ../../tidy.sh",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "build": "vue-tsc -b && vp build",
    "format:check": "bash ../../tidy.sh --check",
    "lint": "vp lint --deny-warnings && eslint . --max-warnings 0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@ovs/helper": "link:../helper",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.20.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.14"
  }
}
